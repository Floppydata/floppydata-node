{
  "name": "@floppydata/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Floppydata Client API v2: Web Data, rotating and static proxies, Cloud Browser.",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Floppydata/floppydata-node.git"
  },
  "bugs": {
    "url": "https://github.com/Floppydata/floppydata-node/issues"
  },
  "homepage": "https://github.com/Floppydata/floppydata-node#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync-spec": "curl -fsSL https://api.floppydata.net/v2/openapi.json -o openapi/v2.json",
    "generate": "openapi-ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "keywords": [
    "floppydata",
    "proxy",
    "rotating-proxy",
    "web-data",
    "scraping",
    "cloud-browser",
    "sdk"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^25.9.9",
    "eslint": "^9.39.5",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
